{
    "siteUpdates": {
        "use": false
    },
    "mapDisplayStatus": {
        "use": false
    },
    "map": {
        "changeMap": true,
        "tileName": "OSMFJ_NOPOI",
        "viewCenter": [
            135.518691,
            34.663617
        ],
        "viewPitch": 30,
        "maxPitch": 60,
        "maxBounds": "",
        "initZoom": 17,
        "maxZoom": 23,
        "detailZoom": 19,
        "zoomMessageThreshold": 17,
        "textFont": [
            "Noto Sans Bold"
        ],
        "textSize": 12,
        "polygonMarker": {
            "fill-color": "#CC6666",
            "fill-opacity": 0.3
        }
    },
    "mapIllustrations": {
        "use": false,
        "autoHide": false,
        "referenceZoom": 15,
        "minZoom": 0,
        "maxZoom": 24,
        "widthPx": 120,
        "mobileWidthPx": 80,
        "shadow": {
            "use": true,
            "color": "rgba(0, 0, 0, 0.25)",
            "blurPx": 4,
            "offsetXPx": 2,
            "offsetYPx": 4
        },
        "maxVisible": {
            "desktop": 4,
            "mobile": 2
        },
        "avoidPaddingPx": 24,
        "illustrationGapPx": 40,
        "items": []
    },
    "minimap": {
        "use": false,
        "height": 200,
        "initZoom": 2,
        "viewCenter": [
            135,
            34
        ]
    },
    "icon": {
        "fgPath": "icon",
        "bgPath": "image",
        "flagPath": "./flags/w40",
        "shadow": 0.7,
        "attention": 0.8,
        "green": 0.6,
        "middle": 0.6,
        "visited": 0.4,
        "normal": 0.6,
        "flag": 0.5,
        "textFont": [
            "Noto Sans Regular"
        ],
        "textSize": 12,
        "textViewZoom": 13,
        "markerColors": {
            "hover": {
                "stroke": "#e9a05b"
            },
            "attention": {
                "fill": "#ffffff",
                "stroke": "#888888"
            },
            "green": {
                "fill": "#ffffff",
                "stroke": "#51b3a1"
            },
            "middle": {
                "fill": "#ffffff",
                "stroke": "#4d77ac"
            },
            "normal": {
                "fill": "#ffffff",
                "stroke": "#bfbfe1"
            },
            "visited": {
                "fill": "#ffffff",
                "stroke": "#9c9c9c"
            }
        }
    },
    "poiView": {
        "poiActLoad": true,
        "poiZoom": {
            "activity": 12,
            "historic": 16,
            "natural": 16,
            "amenity": 16,
            "shop": 16,
            "indoor": 18,
            "parking": 16
        },
        "mobilePoiZoom": {
            "indoor": 17
        },
        "editZoom": {},
        "poiFilter": "all"
    },
    "poiData": {
        "maxFeatures": 12000,
        "pruneThreshold": 15000,
        "applyToStatic": false
    },
    "selectItem": {
        "default": "",
        "menu": "",
        "action": "ChangePoi"
    },
    "sideBar": {
        "everyView": true,
        "initView": "view"
    },
    "listTable": {
        "nameFallback": "category",
        "backgroundImage": "./image/transparent.png",
        "category": "tags",
        "target": "tags",
        "allActs": false,
        "playback": {
            "view": false,
            "zoomLevel": 15,
            "timer": 4000
        },
        "download": false,
        "csvColumn": [
            "id",
            "categoryJa",
            "name",
            "parentName",
            "tag",
            "categoryData",
            "iconFile",
            "lng",
            "lat"
        ],
        "height": 0.6
    },
    "feature3d": {
        "use": true,
        "visualScale": 1,
        "hitArea": {
            "use": true,
            "padding": 0.35,
            "minSize": 2
        },
        "models": {
            "play_aerialrotator": {
                "type": "aerialrotator",
                "size": 2
            },
            "play_basketrotator": {
                "type": "basketrotator",
                "size": 1.8
            },
            "play_activitypanel": {
                "type": "activitypanel",
                "size": 1.6
            },
            "play_cushion": {
                "type": "trampoline",
                "size": 3
            },
            "play_komyaku_eye": {
                "type": "komyaku_eye",
                "size": 2.7
            },
            "play_structure": {
                "url": "./assets/models/playground/poly-pizza/composite-play-structure/composite-play-structure.glb",
                "size": 8
            },
            "play_seesaw": {
                "url": "./assets/models/playground/poly-pizza/seesaw/seesaw.glb",
                "size": 4
            },
            "play_slide": {
                "url": "./assets/models/playground/leonkin-playground/GLTF/slide.glb",
                "size": 4
            },
            "bench": {
                "url": "./assets/models/poi/bench/scene.gltf",
                "size": 2
            },
            "drinking_water": {
                "url": "./assets/models/poi/drinking-water/scene.gltf",
                "size": 1.2,
                "scaleBelowZoom": 19,
                "maxZoomScale": 4
            },
            "vending_machine": {
                "url": "./assets/models/poi/vending-machine/scene.gltf",
                "size": 1.9,
                "scaleBelowZoom": 19,
                "maxZoomScale": 4
            },
            "vending_machine_red": {
                "url": "./assets/models/poi/vending-machine-red/scene.gltf",
                "size": 1.9,
                "scaleBelowZoom": 19,
                "maxZoomScale": 4
            }
        },
        "rules": [
            {
                "tags": {
                    "playground": "aerialrotator"
                },
                "model": "play_aerialrotator"
            },
            {
                "tags": {
                    "playground": "basketrotator"
                },
                "model": "play_basketrotator"
            },
            {
                "tags": {
                    "playground": "activitypanel"
                },
                "model": "play_activitypanel"
            },
            {
                "tags": {
